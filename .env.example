# CampusBuddy Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Port to bind the HTTP server (defaults to 8085 locally, or 10000 on Render)
PORT=8085

# Host interface to bind (use 0.0.0.0 for containers and cloud environments like Render)
HOST=0.0.0.0

# Node runtime environment (development | production | test)
NODE_ENV=development
